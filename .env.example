# Copy to .env.local for local development. Never commit real values.

# Browser-visible and URL-restricted where supported.
VITE_CESIUM_ION_TOKEN=

# The browser only needs the public broker location. Keep broker secrets in
# .env.broker.local, never in this file or VITE_* variables.
VITE_BROKER_BASE_URL=http://127.0.0.1:8787
